@startuml
skinparam classAttributeIconSize 0

class Student {
- studentId: String
- name: String
- email: String
+ getStudentId(): String
}

class Course {
- courseCode: String
- title: String
}

class CourseOffering {
- offeringId: String
- semester: String
- capacity: int
- currentEnrollmentCount: int
+ isFull(): boolean
+ incrementEnrollment(): void
}

class Enrollment {
- enrollmentId: String
- registrationDate: DateTime
}

Student "1" -- "0..*" Enrollment : holds >
CourseOffering "1" -- "0..*" Enrollment : receives >
Course "1" -- "1..*" CourseOffering : is offered as >

note "{Capacity Constraint}\nCourseOffering.currentEnrollmentCount <= CourseOffering.capacity" as N1
CourseOffering .. N1

note "{Uniqueness Constraint}\nUnique composite key: (studentId, offeringId)\nPrevents duplicate active enrollments in the same offering." as N2
Enrollment .. N2

@enduml