
{
  "name": "check_room",
  "description": "Checks whether a room can be booked for a requested time interval. All times must be whole minutes since midnight, in the range 0 to 1440, where 1440 means midnight at the end of the day. The tool checks the room status and existing bookings, but does not save, create, or modify any booking.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "start": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1440
      },
      "end": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1440
      },
      "now": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1440
      },
      "blocked": {
        "type": "boolean"
      },
      "bookings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "start": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            },
            "end": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440
            }
          },
          "required": [
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "start",
      "end",
      "now",
      "blocked",
      "bookings"
    ],
    "additionalProperties": false
  }
}
